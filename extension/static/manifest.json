{
  "manifest_version": 3,
  "name": "Tailor Autofill",
  "version": "1.0.0",
  "description": "Fills job applications from a profile kept in this browser. It never submits and never sends anything anywhere.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Tailor Autofill",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkday.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.jobs.hr.cloud.sap/*",
        "https://*.successfactors.com/*",
        "https://*.successfactors.eu/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
